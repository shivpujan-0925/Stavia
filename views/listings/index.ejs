<%-layout("/layouts/boilerplate.ejs") %>

<style>
   #filters{
    display: flex;
    flex-direction: row;
    align-items: center;
    /* Add these properties for scrolling */
    overflow-x: auto;
    white-space: nowrap;
    padding-bottom: 10px;
    -ms-overflow-stryle: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
   }
    #filters::-webkit-scrollbar {
      display: none;  /* Chrome, Safari, Opera*/
    }

   .filter{
    text-align: center;
    margin-right: 2rem;
    margin-top: 1rem;
    opacity: 0.7;
    min-width: 20vw;
   }
   .filter:hover{
    opacity: 1;
    cursor: pointer;
   }

   .filter p{
    font-size: 0.8rem;
   }

   .tax-info{
    display:none;
   }

   .tax-toggle{
    border: 1px solid rgba(92, 13, 13, 0.763);
    border-radius: 0.8rem;
    height: 3rem;
    padding: 0.6rem;
    margin-left: 2rem;
    display: flex;
    align-items: center;
   }
</style>

<div id="filters">
  <div class="filter">
    <div><i class="fa-solid fa-fire-flame-curved"></i></div>
     <p>Trendings</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-bed"></i></div>
     <p>Beds</p>
  </div>
   <div class="filter">
    <div><i class="fa-solid fa-mountain-city"></i></div>
     <p>iconic cities</p>
  </div>
   <div class="filter">
    <div><i class="fa-solid fa-mountain-sun"></i></div>
     <p>mountains</p>
  </div>
   <div class="filter">
    <div><i class="fa-solid fa-chess-rook"></i></div>
     <p>castles</p>
  </div>
    <div class="filter">
    <div><i class="fa-solid fa-person-swimming"></i></div>
     <p>amazing pools</p>
  </div>
    <div class="filter">
    <div><i class="fa-solid fa-campground"></i></div>
     <p>camping</p>
  </div>
    <div class="filter">
    <div><i class="fa-solid fa-cow"></i></div>
     <p>farms</p>
  </div>
   <div class="filter">
    <div><i class="fa-solid fa-snowflake"></i></div>
     <p>arctic</p>
  </div>

<div class="tax-toggle">
  <div class="form-check form-switch">
  <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault">
  <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
</div>
</div>

</div>   
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-1">
  <%for(let listing of allListing){%>

  <a href="/listings/<%= listing._id %>" class="listing-link">
    <div class="card col listing-card">
      <img
        src="<%= listing.image.url %>"
        class="card-img-top"
        alt="listing_image"
        style="height: 20rem"
      />
      <div class="card-img-overlay"></div>
    <div class="card-body">
      <p class="card-text">
        <b><%= listing.title %></b><br />
        &#8377;<%= listing.price.toLocaleString("en-In") %>/night
        <i class="tax-info"> &nbsp; +18% GST</i>
      </p>
      </div>
    </div>
  </a>
  <%}%>
</div>
<script>
  let taxSwitch = document.getElementById("flexSwitchCheckDefault")
  taxSwitch.addEventListener("click", ()=> {
    let taxInfo = document.getElementsByClassName("tax-info");
    for(info of taxInfo){
      if(info.style.display != "inline"){
       info.style.display = "inline";
      }else{
        info.style.display="none";
      }
      
    }
  });
</script>